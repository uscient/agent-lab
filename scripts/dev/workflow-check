    slice/*/*)
      [[ "$head" =~ ^slice/([a-z0-9][a-z0-9-]{0,47})/[a-z0-9][a-z0-9-]{0,47}$ ]] \
        || return 1
      printf 'origin/work/%s\n' "${BASH_REMATCH[1]}"
      ;;
    slice/* | dev | master | main) return 1 ;;
    *) printf 'origin/dev\n' ;;
  esac
}

check_pr_route() {
  local head="$1" base="$2" expected=""

  expected="$(expected_pr_base "$head")" || {
    fail "PR head is not an authorized workflow branch: $head"
    return
  }
  if [[ "$base" != "$expected" ]]; then
    fail "PR base for $head must be $expected"
    return
  fi
  printf 'PASS workflow PR route=%s->%s\n' "$head" "$base"
}

check_pr_base() {
  local base="$1" head=""

  if ! head="$(git branch --show-current 2>/dev/null)" || [[ -z "$head" ]]; then
    infra "cannot inspect the head branch for the PR base"
    return
  fi
  check_pr_route "$head" "$base"
}

strip_nonprose_markdown() {
  awk '
    BEGIN { fenced = 0; comment = 0; fence_char = ""; fence_length = 0 }
    {
      line = $0
      indent = 0
      while (substr(line, indent + 1, 1) == " " && indent < 4) indent++
      rest = substr(line, indent + 1)
      marker = substr(rest, 1, 1)
      marker_length = 0
      if (indent <= 3 && (marker == "`" || marker == "~")) {
        while (substr(rest, marker_length + 1, 1) == marker) marker_length++
      }
      if (fenced) {
        remainder = substr(rest, marker_length + 1)
        if (marker == fence_char && marker_length >= fence_length \
            && remainder ~ /^[[:space:]]*$/) {
          fenced = 0
          fence_char = ""
          fence_length = 0
        }
        next
      }
      if (!comment && marker_length >= 3) {
        fenced = 1
        fence_char = marker
        fence_length = marker_length
        next
      }

      while (1) {
        if (comment) {
          if (match(line, /-->/)) {
            line = substr(line, RSTART + RLENGTH)
            comment = 0
            continue
          }
          next
        }
        if (match(line, /<!--/)) {
          before = substr(line, 1, RSTART - 1)
          line = substr(line, RSTART + RLENGTH)
          if (before != "") print before
          comment = 1
          continue
        }
        print line
        next
      }
    }
  ' "$1"
}

section_count() {
  awk -v heading="## $2" '$0 == heading { count++ } END { print count + 0 }' "$1"
}

section_line() {
  awk -v heading="## $2" '$0 == heading { print NR; exit }' "$1"
}

section_has_content() {
  awk -v heading="## $2" '
    $0 == heading { found = 1; next }
    found && /^## / { exit }
    found && /[^[:space:]]/ { content = 1 }
    END { exit(content ? 0 : 1) }
  ' "$1"
}

extract_section() {
  awk -v heading="## $2" '
    $0 == heading { found = 1; next }
    found && /^## / { exit }
    found { print }
  ' "$1"
}

validate_evidence() {
  local parsed_file="$1" expected_base="${2:-}" expected_head="${3:-}"
  local expected_route_head="${4:-}" expected_route_base="${5:-}" strict="${6:-0}"

  extract_section "$parsed_file" "Evidence" | awk \
    -v expected_base="$expected_base" -v expected_head="$expected_head" \
    -v expected_route_head="$expected_route_head" -v expected_route_base="$expected_route_base" \
    -v strict="$strict" '
    BEGIN {
      count = 15
      fields[1] = "Route"
      fields[2] = "Base"
      fields[3] = "Head"
      fields[4] = "Scenarios"
      fields[5] = "Assertions"
      fields[6] = "RED predecessor"
      fields[7] = "RED"
      fields[8] = "GREEN"
      fields[9] = "Product mutation"
      fields[10] = "CI mutation"
      fields[11] = "Runner"
      fields[12] = "Duration"
      fields[13] = "Cleanup"
      fields[14] = "Artifacts"
      fields[15] = "Unverified"
    }
    function reject(message) {
      if (error == "") error = message
    }
    function reasoned_na(value, reason) {
      if (index(value, "N/A — ") == 1) reason = substr(value, length("N/A — ") + 1)
      else if (index(value, "N/A - ") == 1) reason = substr(value, length("N/A - ") + 1)
      else return 0
      return reason ~ /[[:alnum:]]/
    }
    function exact_result(value, code, classification) {
      return value ~ ("(^|[[:space:]])rc=" code "([[:space:]]|$)") &&
             value ~ ("(^|[[:space:]])classification=" classification "([[:space:]]|$)")
    }
    function detected_result(value, lower) {
      lower = tolower(value)
      if (lower ~ /(^|[^[:alnum:]])undetected([^[:alnum:]]|$)/ ||
          lower ~ /(^|[^[:alnum:]])not[[:space:]]+detected([^[:alnum:]]|$)/) return 0
      return lower ~ /(^|[^[:alnum:]])detected([^[:alnum:]]|$)/ &&
             exact_result(value, "1", "assertion-failure")
    }
    function sha_value(value, clean) {
      clean = value
      if (substr(clean, 1, 1) != "`" || substr(clean, length(clean), 1) != "`") return ""
      clean = substr(clean, 2, length(clean) - 2)
      if (length(clean) != 40 || clean !~ /^[0-9a-f]+$/) return ""
      return clean
    }
    function finish_cycle() {
      if (!in_cycle) return
      if (field_index != count) {
        reject("Evidence cycle " cycle " field order expected " fields[field_index + 1])
      }
    }
    function validate_field(name, value, clean) {
      if (value == "") {
        reject("Evidence cycle " cycle " " name " is empty")
        return
      }
      if (value ~ /^N\/A([[:space:]]|$)/ && !reasoned_na(value)) {
        reject("Evidence cycle " cycle " " name " N/A requires a reason")
        return
      }
      if (tolower(value) ~ /skipped/ && tolower(value) ~ /(pass|success|green)/) {
        reject("Evidence cycle " cycle " cannot classify skipped evidence as GREEN")
        return
      }
      if (name == "Route") {
        if (value !~ /^`[^`]+` -> `[^`]+`$/) {
          reject("Evidence cycle " cycle " Route must be `head` -> `base`")
        }
        latest_route = value
      } else if (name == "Base" || name == "Head" || name == "RED predecessor") {
        if (name == "RED predecessor" && reasoned_na(value)) {
          if (strict) reject("Evidence cycle " cycle " RED predecessor cannot be N/A in strict mode")
          return
        }
        clean = sha_value(value)
        if (clean == "") reject("Evidence cycle " cycle " " name " must be one exact 40-hex SHA")
        if (name == "Base") latest_base = clean
        if (name == "Head") latest_head = clean
      } else if (name == "RED" && reasoned_na(value)) {
        if (strict) reject("Evidence cycle " cycle " RED cannot be N/A in strict mode")
      } else if (name == "RED" && !exact_result(value, "1", "assertion-failure")) {
        reject("Evidence cycle " cycle " RED must record rc=1 classification=assertion-failure")
      } else if (name == "GREEN" && reasoned_na(value)) {
        if (strict) reject("Evidence cycle " cycle " GREEN cannot be N/A in strict mode")
      } else if (name == "GREEN" && !exact_result(value, "0", "success")) {
        reject("Evidence cycle " cycle " GREEN must record rc=0 classification=success")
      } else if ((name == "Product mutation" || name == "CI mutation") &&
                 reasoned_na(value)) {
        if (strict) reject("Evidence cycle " cycle " " name " cannot be N/A in strict mode")
      } else if ((name == "Product mutation" || name == "CI mutation") &&
                 !detected_result(value)) {
        reject("Evidence cycle " cycle " " name " must record detected rc=1 classification=assertion-failure")
      }
    }
    /^### Cycle [1-9][0-9]*$/ {
      finish_cycle()
      next_cycle = $3 + 0
      if (next_cycle != cycle + 1) {
        reject("Evidence expected Cycle " cycle + 1 ", found Cycle " next_cycle)
      }
      cycle = next_cycle
      in_cycle = 1
      field_index = 0
      next
    }
    /^### / {
      reject("Evidence contains an unsupported heading: " $0)
      next
    }
    in_cycle && /^- / {
      line = substr($0, 3)
      separator = index(line, ": ")
      if (separator == 0) {
        reject("Evidence cycle " cycle " contains a malformed field")
        next
      }
      name = substr(line, 1, separator - 1)
      value = substr(line, separator + 2)
      field_index++
      if (field_index > count || name != fields[field_index]) {
        reject("Evidence cycle " cycle " field order expected " fields[field_index])
        next
      }
      validate_field(name, value)
      next
    }
    /[^[:space:]]/ {
      reject("Evidence contains unsupported content outside a cycle field")
    }
    END {
      finish_cycle()
      if (cycle == 0) reject("Evidence requires Cycle 1")
      if (expected_base != "" && latest_base != expected_base) {
        reject("Evidence latest Base does not match expected PR base")
      }
      if (expected_head != "" && latest_head != expected_head) {
        reject("Evidence latest Head does not match expected PR head")
      }
      if (expected_route_head != "" &&
          latest_route != "`" expected_route_head "` -> `" expected_route_base "`") {
        reject("Evidence latest Route does not match expected PR route")
      }
      if (error != "") {
        print error
        exit 1
      }
    }
  '
}

check_pr_body() {
  local strict="$1"
  shift
  local body_file="$1" expected_base="${2:-}" expected_head="${3:-}"
  local expected_route_head="${4:-}" expected_route_base="${5:-}"
  local parsed_file section count evidence_error evidence_rc=0 testing_valid=0
  local summary_line motivation_line changes_line testing_line testing_text testing_prose
  local evidence_line
  local -a required_sections=("Summary" "Motivation / Context" "Changes" "Testing" "Evidence")

  if [[ ! -f "$body_file" || ! -r "$body_file" ]]; then
    infra "cannot read PR body: $body_file"
    return
  fi
  # GitHub and some clients store PR bodies with CRLF. Section headings must match
  # exactly ("## Summary"), so normalize before parsing.
  body_normalized="$(mktemp)" || {
    infra "cannot create temporary PR body normalization state"
    return
  }
  if ! tr -d '\r' <"$body_file" >"$body_normalized"; then
    find "$body_normalized" -maxdepth 0 -delete >/dev/null 2>&1 || true
    infra "cannot normalize PR body: $body_file"
    return
  fi
  body_file="$body_normalized"
  trap 'find "$body_normalized" -maxdepth 0 -delete >/dev/null 2>&1 || true' RETURN
  if grep -Eiq '^[[:space:]]*>[[:space:]]+\*\*.*Important policy notice\*\*[[:space:]]*$|^## Checklist \(members only\)[[:space:]]*$|^If you are not a member, please close this PR instead of submitting\.[[:space:]]*$' "$body_file"; then
    fail "PR body retains the member notice"
    return
  fi

  parsed_file="$(mktemp)" || {
    infra "cannot create temporary PR body state"
    return
  }
  if ! strip_nonprose_markdown "$body_file" >"$parsed_file"; then
    find "$parsed_file" -maxdepth 0 -delete >/dev/null 2>&1 || true
    infra "cannot parse PR body: $body_file"
    return
  fi

  if grep -Eq '^[[:space:]]*[-*+][[:space:]]+\[[[:space:]]\]' "$parsed_file"; then
    find "$parsed_file" -maxdepth 0 -delete >/dev/null 2>&1 || true
    fail "PR body contains an unchecked placeholder"
    return
  fi
  if grep -Eiq '(One line summary of the change|Why is this change needed|Bullet list of what was done|How was this tested|<!--[[:space:]]*(TODO|TBD|placeholder))' "$body_file"; then
    find "$parsed_file" -maxdepth 0 -delete >/dev/null 2>&1 || true
    fail "PR body retains placeholder text"
    return
  fi

  for section in "${required_sections[@]}"; do
    count="$(section_count "$parsed_file" "$section")"
    if ((count == 0)); then
      find "$parsed_file" -maxdepth 0 -delete >/dev/null 2>&1 || true
      fail "PR body missing section: $section"
      return
    fi
    if ((count > 1)); then
      find "$parsed_file" -maxdepth 0 -delete >/dev/null 2>&1 || true
      fail "PR body has duplicate section: $section"
      return
    fi
  done

  summary_line="$(section_line "$parsed_file" "Summary")"
  motivation_line="$(section_line "$parsed_file" "Motivation / Context")"
  changes_line="$(section_line "$parsed_file" "Changes")"
  testing_line="$(section_line "$parsed_file" "Testing")"
  evidence_line="$(section_line "$parsed_file" "Evidence")"
  if ! ((summary_line < motivation_line && motivation_line < changes_line &&
        changes_line < testing_line && testing_line < evidence_line)); then
    find "$parsed_file" -maxdepth 0 -delete >/dev/null 2>&1 || true
    fail "PR body section order must be Summary, Motivation / Context, Changes, Testing, Evidence"
    return
  fi

  for section in "${required_sections[@]}"; do
    if ! section_has_content "$parsed_file" "$section"; then
      find "$parsed_file" -maxdepth 0 -delete >/dev/null 2>&1 || true
      fail "PR body has empty section: $section"
      return
    fi
  done

  testing_text="$(extract_section "$parsed_file" "Testing")"
  testing_prose="$(sed -E 's/`[^`]*`//g' <<<"$testing_text")"
  if grep -Eq 'Not run[[:space:]]+[-—:][[:space:]]+.*[[:alnum:]]' <<<"$testing_prose"; then
    testing_valid=1
  elif grep -Eq 'Not run([[:space:]]|$)' <<<"$testing_prose"; then
    find "$parsed_file" -maxdepth 0 -delete >/dev/null 2>&1 || true
    fail "PR body Testing Not run requires a reason"
    return
  elif grep -Eq '`[^`]+`' <<<"$testing_text"; then
    if grep -Eiq '(^|[[:space:]:—-])(pass(ed)?|fail(ed)?|result[[:space:]]*:|rc[=:[:space:]]|exit[[:space:]]+[0-9]+|blocked|skipped)([[:space:].,;:()=—-]|$)' <<<"$testing_prose"; then
      testing_valid=1
    else
      find "$parsed_file" -maxdepth 0 -delete >/dev/null 2>&1 || true
      fail "PR body Testing command requires an observed result"
      return
    fi
  else
    find "$parsed_file" -maxdepth 0 -delete >/dev/null 2>&1 || true
    fail "PR body Testing must list an exact command or Not run — reason"
    return
  fi

  if ((testing_valid)); then
    if evidence_error="$(validate_evidence "$parsed_file" "$expected_base" "$expected_head" \
      "$expected_route_head" "$expected_route_base" "$strict" 2>&1)"; then
      evidence_rc=0
    else
      evidence_rc=$?
    fi
    find "$parsed_file" -maxdepth 0 -delete >/dev/null 2>&1 || true
    if ((evidence_rc != 0)); then
      fail "PR body $evidence_error"
      return
    fi
    printf 'PASS workflow PR body\n'
  fi
}

check_evidence_append() {
  local old_body="$1" new_body="$2" state old_parsed new_parsed old_evidence new_evidence
  local old_lines new_lines

  if [[ ! -f "$old_body" || ! -r "$old_body" || ! -f "$new_body" || ! -r "$new_body" ]]; then
    infra "cannot read PR bodies for append-only evidence validation"
    return
  fi
  state="$(mktemp -d)" || {
    infra "cannot create append-only evidence state"
    return
  }
  old_parsed="$state/old.parsed"
  new_parsed="$state/new.parsed"
  old_evidence="$state/old.evidence"
  new_evidence="$state/new.evidence"
  if ! strip_nonprose_markdown "$old_body" > "$old_parsed" ||
     ! strip_nonprose_markdown "$new_body" > "$new_parsed" ||
     ! extract_section "$old_parsed" "Evidence" | awk '/[^[:space:]]/' > "$old_evidence" ||
     ! extract_section "$new_parsed" "Evidence" | awk '/[^[:space:]]/' > "$new_evidence"; then
    find "$state" -depth -delete >/dev/null 2>&1 || true
    infra "cannot compare append-only PR evidence"
    return
  fi
  old_lines="$(wc -l < "$old_evidence" | tr -d '[:space:]')"
  new_lines="$(wc -l < "$new_evidence" | tr -d '[:space:]')"
  if ((old_lines == 0 || new_lines < old_lines)); then
    find "$state" -depth -delete >/dev/null 2>&1 || true
    fail "PR evidence update changed or erased a prior cycle"
    return
  fi
  if ! awk '
    NR == FNR { old[++count] = $0; next }
    FNR <= count && $0 != old[FNR] { changed = 1 }
    END { exit(changed ? 1 : 0) }
  ' "$old_evidence" "$new_evidence"; then
    find "$state" -depth -delete >/dev/null 2>&1 || true
    fail "PR evidence update changed or erased a prior cycle"
    return
  fi
  find "$state" -depth -delete >/dev/null 2>&1 || true
  printf 'PASS workflow append-only evidence\n'
}

check_commits() {
  local base="$1" branch_name expected_base base_oid integration_oid revisions hash author_name author_email
  local subject message trailers ancestry_rc=0 count=0

  if ! command -v git >/dev/null 2>&1; then
    infra "cannot inspect commits without git"
    return
  fi
  if ! branch_name="$(git branch --show-current 2>/dev/null)" || [[ -z "$branch_name" ]]; then
    infra "cannot inspect current branch"
    return
  fi
  expected_base="$(expected_commit_base "$branch_name")" || {
    fail "commit range is not authorized from branch: $branch_name"
    return
  }
  if [[ -z "$base" ]]; then
    base="$expected_base"
  fi
  if ! base_oid="$(GIT_NO_REPLACE_OBJECTS=1 git rev-parse --verify "${base}^{commit}" 2>/dev/null)"; then
    infra "invalid base: $base"
    return
  fi
  if ! integration_oid="$(GIT_NO_REPLACE_OBJECTS=1 git rev-parse --verify "${expected_base}^{commit}" 2>/dev/null)"; then
    infra "cannot resolve $expected_base"
    return
  fi
  if [[ "$base_oid" != "$integration_oid" ]]; then
    fail "commit base must resolve to $expected_base: $base"
    return
  fi
  if ! GIT_NO_REPLACE_OBJECTS=1 git rev-parse --verify 'HEAD^{commit}' >/dev/null 2>&1; then
    infra "cannot resolve HEAD"
    return
  fi
  GIT_NO_REPLACE_OBJECTS=1 git merge-base --is-ancestor "$base_oid" HEAD >/dev/null 2>&1 \
    || ancestry_rc=$?
  case "$ancestry_rc" in
    0) ;;
    1)
      fail "commit base is not an ancestor of HEAD: $base"
      return
      ;;
    *)
      infra "cannot compare commit base with HEAD: $base"
      return
      ;;
  esac
  if ! revisions="$(GIT_NO_REPLACE_OBJECTS=1 git rev-list --reverse --no-merges "${base_oid}..HEAD" 2>/dev/null)"; then
    infra "cannot enumerate introduced commits from base: $base"
    return
  fi

  while IFS= read -r hash; do
    [[ -n "$hash" ]] || continue
    if ! author_name="$(GIT_NO_REPLACE_OBJECTS=1 git show -s --format=%an "$hash" 2>/dev/null)" \
      || ! author_email="$(GIT_NO_REPLACE_OBJECTS=1 git show -s --format=%ae "$hash" 2>/dev/null)" \
      || ! subject="$(GIT_NO_REPLACE_OBJECTS=1 git show -s --format=%s "$hash" 2>/dev/null)" \
      || ! message="$(GIT_NO_REPLACE_OBJECTS=1 git show -s --format=%B "$hash" 2>/dev/null)"; then
      infra "cannot inspect commit: $hash"
      return
    fi
    if [[ "$author_name" != "$expected_author_name" || "$author_email" != "$expected_author_email" ]]; then
      fail "commit $hash sole author must be $expected_author_name <$expected_author_email>"
      return
    fi
    if ! validate_subject "$subject"; then
      fail "invalid commit subject in $hash: $subject_reason"
      return
    fi
    if ! trailers="$(git interpret-trailers --parse <<<"$message" 2>/dev/null)"; then
      infra "cannot parse commit trailers in $hash"
      return
    fi
    if grep -Eiq '^[[:space:]]*(Co-authored-by|Generated-by|Assisted-by)[[:space:]]*:' <<<"$trailers"; then
      fail "commit $hash contains a disallowed attribution trailer"
      return
    fi
    count=$((count + 1))
  done <<<"$revisions"

  printf 'PASS workflow commits=%s\n' "$count"
}

check_all() {
  local base="$1" branch_name

  if ! command -v git >/dev/null 2>&1; then
    infra "cannot inspect workflow without git"
    return
  fi
  if ! branch_name="$(git branch --show-current 2>/dev/null)"; then
    infra "cannot inspect current branch"
    return
  fi
  check_branch "$branch_name" || return
  check_commits "$base"
}

main() {
  local command="${1:-}"
  if (($# > 0)); then
    shift
  fi

  case "$command" in
    branch)
      (($# <= 1)) || { usage; return; }
      check_current_or_named_branch "$@"
      ;;
    commit)
      (($# == 1)) || { usage; return; }
      check_commit_subject "$1"
      ;;
    commits)
      (($# <= 1)) || { usage; return; }
      check_commits "${1:-}"
      ;;
    pr-title)
      (($# == 1)) || { usage; return; }
      check_pr_title "$1"
      ;;
    pr-body)
      (($# == 1 || $# == 3 || $# == 5)) || { usage; return; }
      check_pr_body 0 "$@"
      ;;
    pr-body-strict)
      (($# == 1 || $# == 3 || $# == 5)) || { usage; return; }
      check_pr_body 1 "$@"
      ;;
    evidence-append)
      (($# == 2)) || { usage; return; }
      check_evidence_append "$@"
      ;;
    pr-base)
      (($# == 1)) || { usage; return; }
      check_pr_base "$1"
      ;;
    pr-route)
      (($# == 2)) || { usage; return; }
      check_pr_route "$1" "$2"
      ;;
    all)
      (($# <= 1)) || { usage; return; }
      check_all "${1:-}"
      ;;
    *)
      usage
      ;;
  esac
}

main "$@"
