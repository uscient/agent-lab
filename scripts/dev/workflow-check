#!/usr/bin/env bash
set -euo pipefail

readonly expected_author_name="xormania"
readonly expected_author_email="127287135+xormania@users.noreply.github.com"

usage() {
  cat >&2 <<'EOF'
usage: scripts/dev/workflow-check branch [name]
       scripts/dev/workflow-check commit <subject>
       scripts/dev/workflow-check commits [base]
       scripts/dev/workflow-check pr-title <title>
       scripts/dev/workflow-check pr-body <file> [base-sha head-sha [head-ref base-ref]]
       scripts/dev/workflow-check pr-body-strict <file> [base-sha head-sha [head-ref base-ref]]
       scripts/dev/workflow-check evidence-append <old-body> <new-body>
       scripts/dev/workflow-check pr-base <base>
       scripts/dev/workflow-check pr-route <head> <base>
       scripts/dev/workflow-check all [base]
EOF
  return 2
}

fail() {
  printf 'FAIL workflow %s\n' "$*" >&2
  return 1
}

infra() {
  printf 'INFRA workflow %s\n' "$*" >&2
  return 125
}

subject_reason=""
validate_subject() {
  local subject="$1" lower length

  subject_reason=""
  if [[ "$subject" == *$'\n'* || "$subject" == *$'\r'* ]] \
    || LC_ALL=C grep -q '[^ -~]' <<<"$subject"; then
    subject_reason="must be one printable line"
    return 1
  fi

  lower="${subject,,}"
  if [[ "$lower" =~ ^\[?wip([]:[:space:]-]|$) ]] \
    || [[ "$lower" =~ ^(draft|do[[:space:]]+not[[:space:]]+merge)([]:[:space:]-]|$) ]]; then
    subject_reason="is marked unfinished"
    return 1
  fi
  if [[ "$lower" =~ ^merge([[:space:]]|$) ]]; then
    subject_reason="contains merge boilerplate"
    return 1
  fi
  if [[ "$lower" =~ ^(co-authored|generated|assisted)[[:space:]-]+by([[:space:]]|$) ]]; then
    subject_reason="contains disallowed attribution text"
    return 1
  fi
  if [[ "$subject" =~ ^[[:alnum:]_.-]+/[[:alnum:]_.@/-]+$ ]]; then
    subject_reason="looks branch-derived"
    return 1
  fi
  if [[ "$lower" =~ ^(task|issue|ticket|pr)[[:space:]#:/-]*[0-9]+([[:space:]]+(changes?|updates?|fix(es)?))?$ ]]; then
    subject_reason="is a task-only label"
    return 1
  fi
  if [[ "$lower" =~ ^(dev|update([:][[:space:]]*.*)?|misc(ellaneous)?([[:space:]]+changes?)?|changes?|work|now|agent|codex|claude|grok)$ ]]; then
    subject_reason="is generic"
    return 1
  fi

  length="$(LC_ALL=C printf '%s' "$subject" | wc -c | tr -d '[:space:]')"
  if ((length < 12 || length > 72)); then
    subject_reason="must be 12 to 72 characters"
    return 1
  fi
  if [[ "$subject" != "${subject#"${subject%%[![:space:]]*}"}" ]] \
    || [[ "$subject" != "${subject%"${subject##*[![:space:]]}"}" ]]; then
    subject_reason="must not have leading or trailing whitespace"
    return 1
  fi
  if [[ "$subject" == *. ]]; then
    subject_reason="must not have a trailing period"
    return 1
  fi

  return 0
}

check_branch() {
  local branch_name="$1" lower normalized

  if [[ -z "$branch_name" ]]; then
    fail "branch is detached or empty"
    return
  fi
  case "$branch_name" in
    dev | flow | master | main)
      fail "branch is protected: $branch_name"
      return
      ;;
  esac
  case "$branch_name" in
    work/*)
      [[ "$branch_name" =~ ^work/[a-z0-9][a-z0-9-]{0,47}$ ]] \
        || { fail "invalid reserved workstream branch: $branch_name"; return; }
      ;;
    group/*)
      valid_group "${branch_name#group/}" \
        || { fail "invalid reserved group branch: $branch_name"; return; }
      ;;
    slice/group/*/*)
      [[ "$branch_name" =~ ^slice/group/([gb][0-9]+[a-z]?-[a-z0-9][a-z0-9-]*)/[a-z0-9][a-z0-9-]{0,47}$ ]] &&
        valid_group "${BASH_REMATCH[1]}" \
        || { fail "invalid reserved group slice branch: $branch_name"; return; }
      ;;
    slice/*/*)
      [[ "$branch_name" =~ ^slice/[a-z0-9][a-z0-9-]{0,47}/[a-z0-9][a-z0-9-]{0,47}$ ]] \
        || { fail "invalid reserved workstream slice branch: $branch_name"; return; }
      ;;
    slice/*)
      fail "invalid reserved branch: $branch_name"
      return
      ;;
  esac
  lower="${branch_name,,}"
  case "$lower" in
    agent | changes | codex | claude | grok | now | work)
      fail "branch name is generic: $branch_name"
      return
      ;;
  esac
  if [[ "$branch_name" == *'@{'* ]]; then
    fail "branch uses Git magic syntax: $branch_name"
    return
  fi
  if ! command -v git >/dev/null 2>&1; then
    infra "cannot validate branch without git"
    return
  fi
  if ! normalized="$(git check-ref-format --branch "$branch_name" 2>/dev/null)"; then
    fail "invalid Git branch: $branch_name"
    return
  fi
  if [[ "$normalized" != "$branch_name" ]]; then
    fail "branch uses non-literal Git syntax: $branch_name"
    return
  fi

  printf 'PASS workflow branch=%s\n' "$branch_name"
}

valid_group() {
  [ "${#1}" -le 48 ] && [[ "$1" =~ ^[gb][0-9]+[a-z]?-[a-z0-9][a-z0-9-]*$ ]]
}

check_current_or_named_branch() {
  local branch_name

  if (($# == 1)); then
    branch_name="$1"
  else
    if ! command -v git >/dev/null 2>&1; then
      infra "cannot inspect current branch without git"
      return
    fi
    if ! branch_name="$(git branch --show-current 2>/dev/null)"; then
      infra "cannot inspect current branch"
      return
    fi
  fi
  check_branch "$branch_name"
}

check_commit_subject() {
  local subject="$1"

  if ! validate_subject "$subject"; then
    fail "commit subject $subject_reason"
    return
  fi
  printf 'PASS workflow commit subject\n'
}

check_pr_title() {
  local title="$1" head_branch=""

  if command -v git >/dev/null 2>&1; then
    if ! head_branch="$(git branch --show-current 2>/dev/null)"; then
      infra "cannot inspect the head branch for the PR title"
      return
    fi
    if [[ -z "$head_branch" ]]; then
      infra "cannot inspect the head branch for the PR title"
      return
    fi
  fi
  if [[ -n "$head_branch" && "$title" == "$head_branch" ]]; then
    fail "PR title must not copy the head branch"
    return
  fi
  if ! validate_subject "$title"; then
    fail "PR title $subject_reason"
    return
  fi
  printf 'PASS workflow PR title\n'
}

