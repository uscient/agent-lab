#!/usr/bin/env bash
set -euo pipefail
source "$(git rev-parse --show-toplevel)/scripts/lib/dev-common.sh"
cd_root

mode="${1:-quick}"

case "$mode" in
  quick|full) ;;
  *) die "unknown test mode: $mode (expected quick or full)" ;;
esac

if [ ! -x scripts/dev/security-gate ]; then
  echo "INFRA required security gate is missing or not executable" >&2
  exit 125
fi

./scripts/dev/security-gate fast
if test "$mode" = "full"; then
  ./tools/validate.sh --strict
fi

echo
echo "PASS test $mode (fast gate; static/config validation in full mode)"
