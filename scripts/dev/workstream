#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." >/dev/null 2>&1 && pwd)"
workflow_check="$repo_root/scripts/dev/workflow-check"
cd "$repo_root"

usage() {
  cat >&2 <<'EOF'
Usage:
  scripts/dev/workstream start SLUG
  scripts/dev/workstream group NAME
  scripts/dev/workstream slice NAME
  scripts/dev/workstream sync
  scripts/dev/workstream pr [gh-pr-create options]
  scripts/dev/workstream evidence PR_NUMBER BODY_FILE
  scripts/dev/workstream ready PR_NUMBER
  scripts/dev/workstream merge PR_NUMBER
  scripts/dev/workstream group-pr [gh-pr-create options]
  scripts/dev/workstream final [gh-pr-create options]
EOF
  exit 2
}

die() { printf 'INFRA workstream: %s\n' "$1" >&2; exit 125; }
refuse() { printf 'REFUSE workstream: %s\n' "$1" >&2; exit 1; }

valid_component() {
  [[ "$1" =~ ^[a-z0-9][a-z0-9-]{0,47}$ ]]
}

valid_group() {
  valid_component "$1" && [[ "$1" =~ ^[gb][0-9]+[a-z]?-[a-z0-9][a-z0-9-]*$ ]]
}

real_git=""
real_gh=""
real_jq=""
real_mktemp=""
real_find=""
real_bash=""
for candidate in /usr/bin/git /usr/local/bin/git /bin/git; do
  [ -x "$candidate" ] && { real_git="$candidate"; break; }
done
for candidate in /usr/bin/gh /usr/local/bin/gh; do
  [ -x "$candidate" ] && { real_gh="$candidate"; break; }
done
for candidate in /usr/bin/jq /usr/local/bin/jq /bin/jq; do
  [ -x "$candidate" ] && { real_jq="$candidate"; break; }
done
for candidate in /usr/bin/mktemp /usr/local/bin/mktemp /bin/mktemp; do
  [ -x "$candidate" ] && { real_mktemp="$candidate"; break; }
done
for candidate in /usr/bin/find /usr/local/bin/find /bin/find; do
  [ -x "$candidate" ] && { real_find="$candidate"; break; }
done
for candidate in /usr/bin/bash /bin/bash; do
  [ -x "$candidate" ] && { real_bash="$candidate"; break; }
done
[ -n "$real_git" ] || die "git is unavailable from a trusted system path"
[ -n "$real_gh" ] || die "gh is unavailable from a trusted system path"
[ -n "$real_jq" ] || die "jq is unavailable from a trusted system path"
[ -n "$real_mktemp" ] || die "mktemp is unavailable from a trusted system path"
[ -n "$real_find" ] || die "find is unavailable from a trusted system path"
[ -n "$real_bash" ] || die "bash is unavailable from a trusted system path"
[ -x "$workflow_check" ] || die "workflow evidence checker is unavailable"
repository="uscient/agent-lab"
repository_target="github.com/$repository"
workstream_state=""

cleanup_workstream_state() {
  if [ -n "$workstream_state" ]; then
    "$real_find" "$workstream_state" -depth -delete >/dev/null 2>&1 || true
    workstream_state=""
  fi
}

begin_workstream_state() {
  workstream_state="$($real_mktemp -d)" || die "cannot allocate temporary workstream state"
  trap cleanup_workstream_state EXIT
  trap 'cleanup_workstream_state; exit 125' HUP INT TERM
}

end_workstream_state() {
  cleanup_workstream_state
  trap - EXIT HUP INT TERM
}

current_branch() {
  "$real_git" -C "$repo_root" symbolic-ref --short -q HEAD 2>/dev/null \
    || die "the checkout is detached"
}

require_clean() {
  [ -z "$("$real_git" -C "$repo_root" status --porcelain)" ] \
    || refuse "the tracked checkout is not clean"
}

reject_routing_options() {
  local argument
  for argument in "$@"; do
    case "$argument" in
      --base | --base=* | -B | -B?* | --head | --head=* | -H | -H?* | \
      --repo | --repo=* | -R | -R?* | --hostname | --hostname=*)
        refuse "base, head, repository, and hostname are derived from the workstream"
        ;;
    esac
  done
}

command_name="${1:-}"
[ -n "$command_name" ] || usage
shift

case "$command_name" in
  start)
    [ "$#" -eq 1 ] || usage
    slug="$1"
    valid_component "$slug" || refuse "invalid workstream slug: $slug"
    require_clean
    "$real_git" -C "$repo_root" fetch origin dev
    dev_sha="$("$real_git" -C "$repo_root" rev-parse --verify origin/dev)" \
      || die "origin/dev is unavailable"
    "$real_gh" api "repos/$repository/git/refs" --hostname github.com --method POST \
      -f "ref=refs/heads/work/$slug" -f "sha=$dev_sha" >/dev/null \
      || die "cannot create work/$slug at origin/dev"
    "$real_git" -C "$repo_root" fetch origin "work/$slug"
    "$real_git" -C "$repo_root" switch -c "work/$slug" --track "origin/work/$slug"
    ;;
  group)
    [ "$#" -eq 1 ] || usage
    group="$1"
    valid_group "$group" || refuse "invalid group name: $group"
    require_clean
    "$real_git" -C "$repo_root" fetch origin flow
    flow_sha="$("$real_git" -C "$repo_root" rev-parse --verify origin/flow)" \
      || die "origin/flow is unavailable"
    "$real_gh" api "repos/$repository/git/refs" --hostname github.com --method POST \
      -f "ref=refs/heads/group/$group" -f "sha=$flow_sha" >/dev/null \
      || die "cannot create group/$group at origin/flow"
    "$real_git" -C "$repo_root" fetch origin "group/$group"
    "$real_git" -C "$repo_root" switch -c "group/$group" --track "origin/group/$group"
    ;;
  slice)
    [ "$#" -eq 1 ] || usage
    name="$1"
    valid_component "$name" || refuse "invalid slice name: $name"
    branch="$(current_branch)"
    case "$branch" in
      work/*)
        slug="${branch#work/}"
        valid_component "$slug" || refuse "invalid current workstream branch"
        base="work/$slug"
        slice_branch="slice/$slug/$name"
        ;;
      group/*)
        group="${branch#group/}"
        valid_group "$group" || refuse "invalid current group branch"
        base="group/$group"
        slice_branch="slice/group/$group/$name"
        ;;
      *) refuse "slice creation requires a work/<slug> or group/<id>-<slug> branch" ;;
    esac
    require_clean
    "$real_git" -C "$repo_root" fetch origin "$base"
    "$real_git" -C "$repo_root" merge --ff-only "origin/$base" \
      || refuse "$branch diverged from its integration ref; refusing to rewrite accepted history"
    "$real_git" -C "$repo_root" switch -c "$slice_branch" "origin/$base"
    ;;
  sync)
    [ "$#" -eq 0 ] || usage
    require_clean
    branch="$(current_branch)"
    case "$branch" in
      work/*)
        slug="${branch#work/}"
        valid_component "$slug" || refuse "invalid current workstream branch"
        base="dev"
        sync_mode="merge"
        ;;
      group/*)
        group="${branch#group/}"
        valid_group "$group" || refuse "invalid current group branch"
        base="flow"
        sync_mode="merge"
        ;;
      slice/group/*/*)
        remainder="${branch#slice/group/}"
        group="${remainder%%/*}"
        name="${remainder#*/}"
        valid_group "$group" && valid_component "$name" \
          || refuse "invalid group slice branch"
        base="group/$group"
        sync_mode="merge"
        ;;
      slice/*/*)
        remainder="${branch#slice/}"
        slug="${remainder%%/*}"
        name="${remainder#*/}"
        valid_component "$slug" && valid_component "$name" \
          || refuse "invalid workstream slice branch"
        base="work/$slug"
        sync_mode="rebase"
        ;;
      *) refuse "sync requires a workstream, group, or matching slice branch" ;;
    esac
    if [[ "$branch" == group/* || "$branch" == work/* ]]; then
      "$real_git" -C "$repo_root" fetch origin "$branch" "$base"
      "$real_git" -C "$repo_root" merge --ff-only "origin/$branch" \
        || refuse "$branch diverged from its integration ref; refusing to rewrite accepted history"
    else
      "$real_git" -C "$repo_root" fetch origin "$base"
    fi
    case "$sync_mode" in
      merge)
        "$real_git" -C "$repo_root" merge --no-ff --no-edit "origin/$base"
        ;;
      rebase) "$real_git" -C "$repo_root" rebase "origin/$base" ;;
    esac
    ;;
  pr)
    reject_routing_options "$@"
    branch="$(current_branch)"
    case "$branch" in
      slice/group/*/*)
        remainder="${branch#slice/group/}"
        group="${remainder%%/*}"
        name="${remainder#*/}"
        valid_group "$group" && valid_component "$name" \
          || refuse "invalid group slice branch"
        base="group/$group"
        ;;
      slice/*/*)
        remainder="${branch#slice/}"
        slug="${remainder%%/*}"
        name="${remainder#*/}"
        valid_component "$slug" && valid_component "$name" \
          || refuse "invalid workstream slice branch"
        base="work/$slug"
        ;;
      *) refuse "slice PR creation requires a matching slice branch" ;;
    esac
    exec "$real_gh" pr create --repo "$repository_target" --base "$base" --head "$branch" "$@"
    ;;
  evidence)
    [ "$#" -eq 2 ] || usage
    pr_number="$1"
    body_file="$2"
    [[ "$pr_number" =~ ^[1-9][0-9]*$ ]] || refuse "PR number must be a positive integer"
    [ -f "$body_file" ] && [ -r "$body_file" ] || refuse "evidence body must be a readable file"
    branch="$(current_branch)"
    case "$branch" in
      work/*)
        valid_component "${branch#work/}" || refuse "invalid current workstream branch"
        base=dev
        ;;
      group/*)
        valid_group "${branch#group/}" || refuse "invalid current group branch"
        base=flow
        ;;
      slice/group/*/*)
        remainder="${branch#slice/group/}"
        group="${remainder%%/*}"
        name="${remainder#*/}"
        valid_group "$group" && valid_component "$name" || refuse "invalid group slice branch"
        base="group/$group"
        ;;
      slice/*/*)
        remainder="${branch#slice/}"
        slug="${remainder%%/*}"
        name="${remainder#*/}"
        valid_component "$slug" && valid_component "$name" || refuse "invalid workstream slice branch"
        base="work/$slug"
        ;;
      flow) base=dev ;;
      *) refuse "evidence update requires a program or matching legacy-workstream branch" ;;
    esac
    require_clean
    metadata="$($real_gh pr view "$pr_number" --repo "$repository_target" \
      --json number,state,baseRefName,baseRefOid,headRefName,headRefOid,isCrossRepository,headRepository,body)" \
      || die "cannot read PR $pr_number"
    if ! printf '%s' "$metadata" | "$real_jq" -e \
      --argjson number "$pr_number" --arg branch "$branch" --arg base "$base" \
      --arg repository "$repository" '
      (.number == $number) and (.state == "OPEN") and
      (.isCrossRepository == false) and (.headRepository.nameWithOwner == $repository) and
      (.headRefName == $branch) and (.baseRefName == $base) and
      (.baseRefOid | test("^[0-9a-f]{40}$")) and
      (.headRefOid | test("^[0-9a-f]{40}$")) and (.body | type == "string")
    ' >/dev/null; then
      refuse "PR $pr_number is not the open same-repository PR for $branch -> $base"
    fi
    base_sha="$(printf '%s' "$metadata" | "$real_jq" -r .baseRefOid)"
    head_sha="$(printf '%s' "$metadata" | "$real_jq" -r .headRefOid)"
    begin_workstream_state
    old_body="$workstream_state/old-body"
    printf '%s' "$metadata" | "$real_jq" -er '.body' > "$old_body" \
      || die "cannot read existing evidence for PR $pr_number"
    if ! PATH=/usr/bin:/bin "$real_bash" "$workflow_check" pr-body-strict "$body_file" "$base_sha" "$head_sha" "$branch" "$base" >/dev/null; then
      refuse "replacement evidence for PR $pr_number is missing, malformed, or stale"
    fi
    if ! PATH=/usr/bin:/bin "$real_bash" "$workflow_check" evidence-append "$old_body" "$body_file" >/dev/null; then
      refuse "replacement evidence for PR $pr_number changed or erased prior cycles"
    fi
    "$real_gh" pr edit "$pr_number" --repo "$repository_target" --body-file "$body_file" >/dev/null \
      || die "cannot update evidence for PR $pr_number"
    post_metadata="$($real_gh pr view "$pr_number" --repo "$repository_target" \
      --json number,state,baseRefName,baseRefOid,headRefName,headRefOid,isCrossRepository,headRepository,body)" \
      || die "cannot confirm PR $pr_number evidence update"
    if ! printf '%s' "$post_metadata" | "$real_jq" -e --rawfile expected "$body_file" \
      --argjson number "$pr_number" --arg branch "$branch" --arg base "$base" \
      --arg base_sha "$base_sha" --arg head_sha "$head_sha" '
      def trim_one_newline: sub("\\n$"; "");
      (.number == $number) and (.state == "OPEN") and
      (.headRefName == $branch) and (.baseRefName == $base) and
      (.baseRefOid == $base_sha) and (.headRefOid == $head_sha) and
      ((.body | trim_one_newline) == ($expected | trim_one_newline))
    ' >/dev/null; then
      die "PR $pr_number changed while its evidence update was being confirmed"
    fi
    end_workstream_state
    printf 'PASS workstream updated append-only evidence for PR %s at head %s\n' \
      "$pr_number" "$head_sha"
    ;;
  ready)
    [ "$#" -eq 1 ] || usage
    pr_number="$1"
    [[ "$pr_number" =~ ^[1-9][0-9]*$ ]] || refuse "PR number must be a positive integer"
    branch="$(current_branch)"
    expected_base=""
    case "$branch" in
      group/*)
        valid_group "${branch#group/}" || refuse "invalid current group branch"
        expected_base="flow"
        ;;
      slice/group/*/*)
        if [[ "$branch" =~ ^slice/group/([^/]+)/([^/]+)$ ]]; then
          group_id="${BASH_REMATCH[1]}"
          slice_id="${BASH_REMATCH[2]}"
        else
          refuse "invalid current group-slice branch"
        fi
        valid_group "$group_id" || refuse "invalid current group-slice parent"
        valid_component "$slice_id" || refuse "invalid current group-slice name"
        expected_base="group/$group_id"
        ;;
      *) refuse "ready requires a Group or matching Group-slice branch" ;;
    esac
    require_clean
    metadata="$("$real_gh" pr view "$pr_number" --repo "$repository_target" \
      --json number,state,isDraft,baseRefName,baseRefOid,headRefName,headRefOid,isCrossRepository,headRepository)" \
      || die "cannot read PR $pr_number"
    if ! printf '%s' "$metadata" | "$real_jq" -e \
      --argjson number "$pr_number" --arg branch "$branch" --arg repository "$repository" \
      --arg expected_base "$expected_base" '
      (.number == $number) and
      (.state == "OPEN") and
      (.isDraft == true) and
      (.baseRefName == $expected_base) and
      (.headRefName == $branch) and
      (.isCrossRepository == false) and
      (.headRepository.nameWithOwner == $repository) and
      (.baseRefOid | test("^[0-9a-f]{40}$")) and
      (.headRefOid | test("^[0-9a-f]{40}$"))
    ' >/dev/null; then
      refuse "PR $pr_number is not the exact draft program PR for the current branch"
    fi
    base_sha="$(printf '%s' "$metadata" | "$real_jq" -r .baseRefOid)"
    head_sha="$(printf '%s' "$metadata" | "$real_jq" -r .headRefOid)"
    "$real_gh" pr ready "$pr_number" --repo "$repository_target" \
      || refuse "GitHub did not make PR $pr_number ready"
    confirmed="$("$real_gh" pr view "$pr_number" --repo "$repository_target" \
      --json number,state,isDraft,baseRefName,baseRefOid,headRefName,headRefOid,isCrossRepository,headRepository)" \
      || die "cannot confirm PR $pr_number readiness"
    if ! printf '%s' "$confirmed" | "$real_jq" -e \
      --argjson number "$pr_number" --arg branch "$branch" --arg repository "$repository" \
      --arg base "$base_sha" --arg head "$head_sha" --arg expected_base "$expected_base" '
      (.number == $number) and
      (.state == "OPEN") and
      (.isDraft == false) and
      (.baseRefName == $expected_base) and
      (.baseRefOid == $base) and
      (.headRefName == $branch) and
      (.headRefOid == $head) and
      (.isCrossRepository == false) and
      (.headRepository.nameWithOwner == $repository)
    ' >/dev/null; then
      refuse "PR $pr_number identity changed while becoming ready"
    fi
    printf 'PASS workstream made program PR %s ready at head %s\n' "$pr_number" "$head_sha"
    ;;
  merge)
    [ "$#" -eq 1 ] || usage
    pr_number="$1"
    [[ "$pr_number" =~ ^[1-9][0-9]*$ ]] || refuse "PR number must be a positive integer"
    branch="$(current_branch)"
    case "$branch" in
      work/*) valid_component "${branch#work/}" || refuse "invalid current workstream branch" ;;
      group/*) valid_group "${branch#group/}" || refuse "invalid current group branch" ;;
      flow) ;;
      *) refuse "merge requires a work/<slug>, group/<id>-<slug>, or flow integration branch" ;;
    esac
    require_clean
    metadata="$($real_gh pr view "$pr_number" \
      --repo "$repository_target" \
      --json number,state,isDraft,baseRefName,baseRefOid,headRefName,headRefOid,isCrossRepository,headRepository,mergeStateStatus,reviewDecision,statusCheckRollup,body)" \
      || die "cannot read PR $pr_number"
    if ! printf '%s' "$metadata" | "$real_jq" -e \
      --argjson number "$pr_number" --arg branch "$branch" --arg repository "$repository" '
      (.statusCheckRollup |
        group_by([(.workflowName // ""), .name]) |
        map(sort_by([(.startedAt // ""), (.completedAt // ""), (.detailsUrl // "")]) | last)
      ) as $latest_checks |
      (.number == $number) and
      (.state == "OPEN") and
      (.isDraft == false) and
      (.isCrossRepository == false) and
      (.headRepository.nameWithOwner == $repository) and
      (.baseRefName == $branch) and
      (((.baseRefName | test("^work/[a-z0-9][a-z0-9-]{0,47}$")) and
        (.headRefName | test("^slice/[a-z0-9][a-z0-9-]{0,47}/[a-z0-9][a-z0-9-]{0,47}$")) and
        ((.baseRefName | sub("^work/"; "")) ==
         (.headRefName | capture("^slice/(?<slug>[^/]+)/").slug))) or
       ((.baseRefName | test("^group/[gb][0-9]+[a-z]?-[a-z0-9][a-z0-9-]*$")) and
        (.headRefName | test("^slice/group/[gb][0-9]+[a-z]?-[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]{0,47}$")) and
        ((.baseRefName | sub("^group/"; "")) ==
         (.headRefName | capture("^slice/group/(?<group>[^/]+)/").group))) or
       ((.baseRefName == "flow") and
        (.headRefName | test("^group/[gb][0-9]+[a-z]?-[a-z0-9][a-z0-9-]*$")) and
        ((.headRefName | sub("^group/"; "") | length) <= 48))) and
      (.baseRefOid | test("^[0-9a-f]{40}$")) and
      (.headRefOid | test("^[0-9a-f]{40}$")) and
      (.mergeStateStatus == "CLEAN") and
      ((((.baseRefName == "flow") or
         (.baseRefName | test("^group/[gb][0-9]+[a-z]?-[a-z0-9][a-z0-9-]*$"))) and
        ((.reviewDecision == null) or (.reviewDecision == "") or
         (.reviewDecision == "REVIEW_REQUIRED") or (.reviewDecision == "APPROVED"))) or
       (((.baseRefName != "flow") and
         (.baseRefName | test("^group/[gb][0-9]+[a-z]?-[a-z0-9][a-z0-9-]*$") | not)) and
        (.reviewDecision == "APPROVED"))) and
      ((.statusCheckRollup | length) > 0) and
      ((.statusCheckRollup |
        map([(.workflowName // ""), .name, (.startedAt // ""),
             (.completedAt // ""), (.detailsUrl // "")]) | unique | length) ==
       (.statusCheckRollup | length)) and
      (($latest_checks | length) > 0) and
      (([$latest_checks[] | select(.name == "Required gates" and
        .workflowName == "CI" and
        .status == "COMPLETED" and .conclusion == "SUCCESS")] | length) == 1) and
      (([$latest_checks[] | select(.name == "CodeQL" and
        .workflowName == "CodeQL" and
        .status == "COMPLETED" and .conclusion == "SUCCESS")] | length) == 1) and
      (all($latest_checks[]; .status == "COMPLETED" and .conclusion == "SUCCESS"))
    ' >/dev/null; then
      refuse "PR $pr_number is not a current-base intermediate PR with every check successful"
    fi
    base_sha="$(printf '%s' "$metadata" | "$real_jq" -r .baseRefOid)"
    head_sha="$(printf '%s' "$metadata" | "$real_jq" -r .headRefOid)"
    base_ref="$(printf '%s' "$metadata" | "$real_jq" -r .baseRefName)"
    head_ref="$(printf '%s' "$metadata" | "$real_jq" -r .headRefName)"
    begin_workstream_state
    evidence_file="$workstream_state/pr-body"
    if ! printf '%s' "$metadata" | "$real_jq" -er '.body | select(type == "string")' \
      > "$evidence_file"; then
      refuse "PR $pr_number has no readable evidence ledger"
    fi
    if PATH=/usr/bin:/bin "$real_bash" "$workflow_check" pr-body-strict "$evidence_file" "$base_sha" "$head_sha" "$head_ref" "$base_ref" >/dev/null; then
      :
    else
      evidence_rc=$?
      case "$evidence_rc" in
        1) refuse "PR $pr_number evidence is missing, malformed, or stale" ;;
        125) die "cannot validate PR $pr_number evidence" ;;
        *) die "PR $pr_number evidence validator returned unexpected status $evidence_rc" ;;
      esac
    fi
    end_workstream_state
    comparison="$($real_gh api "repos/$repository/compare/$base_sha...$head_sha" \
      --hostname github.com --jq .status)" \
      || die "cannot prove PR $pr_number contains its observed base"
    case "$comparison" in
      ahead | identical) ;;
      *) refuse "PR $pr_number head does not contain its observed base" ;;
    esac
    if [ "$branch" = flow ]; then
      base_checks="$($real_gh api "repos/$repository/commits/$base_sha/check-runs?per_page=100&filter=latest" \
        --hostname github.com)" || die "cannot read checks for observed flow base $base_sha"
      if ! printf '%s' "$base_checks" | "$real_jq" -e '
        (.check_runs | type == "array") and
        (([.check_runs[] | select(.name == "Required gates" and
          .app.slug == "github-actions" and
          .status == "completed" and .conclusion == "success")] | length) == 1) and
        (([.check_runs[] | select(.name == "CodeQL" and
          .app.slug == "github-actions" and
          .status == "completed" and .conclusion == "success")] | length) == 1)
      ' >/dev/null; then
        refuse "observed flow base $base_sha is not green for Required gates and CodeQL"
      fi
    fi
    merge_result="$($real_gh api "repos/$repository/pulls/$pr_number/merge" \
      --hostname github.com --method PUT -f "merge_method=merge" -f "sha=$head_sha")" \
      || refuse "GitHub did not accept an immediate merge for PR $pr_number"
    if ! printf '%s' "$merge_result" | "$real_jq" -e \
      '.merged == true and (.sha | test("^[0-9a-f]{40}$"))' >/dev/null; then
      refuse "PR $pr_number was not merged immediately; merge queues are not an intermediate route"
    fi
    post_state="$($real_gh pr view "$pr_number" --repo "$repository_target" \
      --json state --jq .state)" \
      || die "cannot confirm PR $pr_number after merge request"
    case "$post_state" in
      MERGED) printf 'PASS workstream merged PR %s at head %s\n' "$pr_number" "$head_sha" ;;
      OPEN) refuse "PR $pr_number is queued or still open; integration is not yet complete" ;;
      *) die "PR $pr_number ended in unexpected state: ${post_state:-<empty>}" ;;
    esac
    ;;
  group-pr)
    reject_routing_options "$@"
    branch="$(current_branch)"
    case "$branch" in
      group/*) group="${branch#group/}" ;;
      *) refuse "group PR creation requires group/<id>-<slug>" ;;
    esac
    valid_group "$group" || refuse "invalid current group branch"
    exec "$real_gh" pr create --repo "$repository_target" \
      --base flow --head "$branch" --draft "$@"
    ;;
  final)
    reject_routing_options "$@"
    branch="$(current_branch)"
    case "$branch" in
      work/*)
        slug="${branch#work/}"
        valid_component "$slug" || refuse "invalid current workstream branch"
        ;;
      flow) ;;
      *) refuse "final PR creation requires work/<slug> or protected flow" ;;
    esac
    exec "$real_gh" pr create --repo "$repository_target" \
      --base dev --head "$branch" --draft "$@"
    ;;
  *) usage ;;
esac
