#!/usr/bin/env bash
set -euo pipefail
source "$(git rev-parse --show-toplevel)/scripts/lib/dev-common.sh"
cd_root

fail=0
scripts=()

mapfile -t candidates < <(
  {
    find scripts tools tests -type f 2>/dev/null
    git ls-files
  } | sort -u
)
for f in "${candidates[@]}"; do
  test -f "$f" || continue
  if [[ "$f" == *.sh ]] || head -n 1 "$f" | grep -Eq '^#!.*(bash|dash|ksh|zsh|/sh)([[:space:]]|$)'; then
    scripts+=("$f")
  fi
done

if test "${#scripts[@]}" -eq 0; then
  echo "INFRA no shell scripts discovered" >&2
  exit 125
fi

echo "== bash -n =="
for f in "${scripts[@]}"; do
  test -f "$f" || continue
  if head -n 1 "$f" | grep -Eq 'bash|/sh' || [[ "$f" == *.sh ]] || [[ "$f" == scripts/* ]]; then
    echo "$f"
    bash -n "$f" || fail=1
  fi
done

if ! command -v shellcheck >/dev/null 2>&1; then
  echo "INFRA shellcheck is required" >&2
  exit 125
fi

echo
echo "== shellcheck =="
shellcheck "${scripts[@]}" || fail=1

test "$fail" -eq 0 || die "script lint failed"
echo "PASS lint-scripts"
