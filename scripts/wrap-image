#!/usr/bin/env bash
set -euo pipefail

# Make a third-party image agent-lab-compliant by baking in tools/agent-entrypoint.sh
# (file-based secret loading) while preserving the image's original behavior. The original
# ENTRYPOINT+CMD are combined into the wrapper's CMD, so our entrypoint's `exec "$@"`
# reproduces the original command with secret-loading prepended.

source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)/common"

usage() {
  printf 'Usage: %s BASE_IMAGE [WRAPPED_TAG]\n' "$0" >&2
  printf '  Default tag: agent-lab/<base-name>:wrapped\n' >&2
  printf '  Then run it: AGENT_LAB_AGENT_IMAGE=<tag> scripts/agent\n' >&2
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  "") usage; exit 1 ;;
esac

base="$1"
wrapped="${2:-}"

valid_image_reference() {
  case "$1" in
    ''|-*|*://*|*[!A-Za-z0-9._/@:+-]*) return 1 ;;
    *) return 0 ;;
  esac
}

if ! valid_image_reference "$base"; then
  printf 'FAIL invalid base image reference: %s\n' "$base" >&2
  exit 1
fi

command -v docker >/dev/null 2>&1 || { printf 'FAIL docker is required\n' >&2; exit 1; }

# Default wrapped tag from the base image's bare name (strip registry path, :tag, @digest).
if [ -z "$wrapped" ]; then
  name="$base"
  name="${name%@*}"     # drop @digest
  name="${name##*/}"    # drop registry/path
  name="${name%:*}"     # drop :tag
  wrapped="agent-lab/${name}:wrapped"
fi
if ! valid_image_reference "$wrapped"; then
  printf 'FAIL invalid wrapped image tag: %s\n' "$wrapped" >&2
  exit 1
fi

# Pull the base image if it is not already present locally.
if ! docker image inspect "$base" >/dev/null 2>&1; then
  printf 'Pulling %s\n' "$base"
  docker pull "$base"
fi

orig_entrypoint="$(docker inspect -f '{{json .Config.Entrypoint}}' "$base")"
orig_cmd="$(docker inspect -f '{{json .Config.Cmd}}' "$base")"
orig_user="$(docker inspect -f '{{.Config.User}}' "$base")"

# Prepend our secret loader to the original exec-form entrypoint. The base CMD remains
# inherited rather than being flattened into ENTRYPOINT, preserving `docker run IMAGE ARG`
# semantics: runtime arguments still replace CMD while the original entrypoint remains.
wrapped_entrypoint() {
  local entrypoint="$1"
  case "$entrypoint" in
    null|'[]') printf '["/usr/local/bin/agent-entrypoint"]' ;;
    \[*\])
      printf '["/usr/local/bin/agent-entrypoint",%s' "${entrypoint#\[}"
      ;;
    *)
      printf 'FAIL invalid entrypoint metadata from base image\n' >&2
      return 1
      ;;
  esac
}

entrypoint="$(wrapped_entrypoint "$orig_entrypoint")"
case "$orig_cmd" in
  null|\[*\]) ;;
  *)
    printf 'FAIL invalid command metadata from base image\n' >&2
    exit 1
    ;;
esac

printf 'Base image:          %s\n' "$base"
printf 'Original ENTRYPOINT: %s\n' "$orig_entrypoint"
printf 'Original CMD:        %s\n' "$orig_cmd"
printf 'Original USER:       %s\n' "${orig_user:-<root>}"
printf 'Wrapped ENTRYPOINT:  %s\n' "$entrypoint"

if [ "$orig_entrypoint" = null ] && [ "$orig_cmd" = null ]; then
  printf 'WARN base declares neither ENTRYPOINT nor CMD; supply a command at runtime:\n' >&2
  printf 'WARN   scripts/agent -- <cmd>\n' >&2
fi

# Use a purpose-built context. A hostile base's ONBUILD COPY can see only these explicit
# wrapper inputs, never the repository, ignored files, credentials, caches, or logs.
build_context="$(mktemp -d "${TMPDIR:-/tmp}/agent-lab-wrap.XXXXXX")"
dockerfile="${build_context}/Dockerfile"
entrypoint_file="${build_context}/agent-entrypoint.sh"
dockerignore="${build_context}/.dockerignore"
cleanup() {
  rm -f "$dockerfile" "$entrypoint_file" "$dockerignore"
  rmdir "$build_context"
}
trap cleanup EXIT
cp "${REPO_ROOT}/tools/agent-entrypoint.sh" "$entrypoint_file"
chmod 0755 "$entrypoint_file"

{
  printf 'FROM %s\n' "$base"
  printf 'COPY agent-entrypoint.sh /usr/local/bin/agent-entrypoint\n'
  printf 'ENTRYPOINT %s\n' "$entrypoint"
  [ "$orig_cmd" != null ] && printf 'CMD %s\n' "$orig_cmd"
} > "$dockerfile"
{
  printf '*\n'
  printf '!Dockerfile\n'
  printf '!agent-entrypoint.sh\n'
  printf '!.dockerignore\n'
} > "$dockerignore"

printf 'Building %s\n' "$wrapped"
docker build --network=none -t "$wrapped" -f "$dockerfile" "$build_context"

printf 'PASS wrapped image ready: %s\n' "$wrapped"
