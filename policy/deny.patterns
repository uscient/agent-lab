# policy/deny.patterns — unconditional control-plane denials (extended regex; one per line).
# Read by tools/pretooluse-guard.sh; tools/codex-permission-request.sh delegates to that guard.
# AGENTS.md is the operating-policy source. Branch-derived rebase and PR routes, same-branch push,
# and protected integration decisions are implemented by the guard, argv shims, and workstream helper.
#
# The git<->subcommand separator is [^[:alnum:]_]+ (not just whitespace) so the common quoted/
# bracketed argv forms are caught too (e.g. subprocess(["git","push"])). The leading anchor
# (^|[^[:alnum:]_])git prevents matching words that merely end in "git" (e.g. "legit push").
# The guard strips simple quoted commit-message arguments before matching; substitutions and other
# executable forms remain visible and fail closed.

# --- pull (mutates local via merge/rebase) ---
(^|[^[:alnum:]_])git([[:space:]]+-C[[:space:]]+[^[:space:]]+)?[^[:alnum:]_]+pull([^[:alnum:]_]|$)

# --- remote merge is the 2nd half of a pull ---
(^|[^[:alnum:]_])git([[:space:]]+-C[[:space:]]+[^[:space:]]+)?[[:space:]]+merge([[:space:]]+[^[:space:]]+)*[[:space:]]+(origin|upstream)/
(^|[^[:alnum:]_])git([[:space:]]+-C[[:space:]]+[^[:space:]]+)?[[:space:]]+merge([[:space:]]+[^[:space:]]+)*[[:space:]]+refs/remotes/

# --- authentication, credential, and Git configuration access ---
(^|[^[:alnum:]_])git([[:space:]]+[^[:space:]]+)*[[:space:]]+(config|credential)([^[:alnum:]_]|$)
(^|[^[:alnum:]_])git[[:space:]]+-c[[:space:]]+alias\.
(^|[^[:alnum:]_])git[[:space:]]+-calias\.

# --- unauthorized forge writes (the guard default-denies non-PR gh commands) ---
gh[[:space:]]+pr[[:space:]]+(merge|close|edit|ready|reopen|review|comment)([[:space:]]|$)
gh[[:space:]]+release[[:space:]]+(create|delete|edit|upload)([[:space:]]|$)
gh[[:space:]]+api[[:space:]].*((-X|--method)[=[:space:]]*(POST|PUT|PATCH|DELETE))
glab[[:space:]]+mr([[:space:]]|$)

# --- remote-config mutation ---
(^|[^[:alnum:]_])git([[:space:]]+[^[:space:]]+)*[[:space:]]+remote[[:space:]]+(add|set-url|remove|rm|rename|prune|set-head|set-branches|update)

# --- Git attribution / signing identity overrides ---
(^|[^[:alnum:]_])git[[:space:]]+-c[[:space:]]+(user\.(name|email|signingkey)|commit\.gpgsign)=
(^|[^[:alnum:]_])git[[:space:]]+-c(user\.(name|email|signingkey)|commit\.gpgsign)=
(^|[^[:alnum:]_])git[[:space:]]+--config-env(=|[[:space:]]+)(user\.(name|email|signingkey)|commit\.gpgsign)=
(^|[^[:alnum:]_])git[[:space:]]+commit([[:space:]]+[^[:space:]]+)*[[:space:]]+(--author|--reset-author)([=[:space:]]|$)
(^|[[:space:]])GIT_(AUTHOR|COMMITTER)_(NAME|EMAIL)=
