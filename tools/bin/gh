#!/usr/bin/env bash
# PATH shim for `gh` — allows read-only PR and Actions diagnosis plus PR creation to dev while
# blocking authentication, integration, release mutation, and other remote writes. Slice integration
# is available only through scripts/dev/workstream. Defense-in-depth; AGENTS.md is authoritative.
set -uo pipefail

self="$(readlink -f "${BASH_SOURCE[0]}")"
selfdir="$(dirname "$self")"
real=""
while IFS= read -r cand; do
  rcand="$(readlink -f "$cand" 2>/dev/null || echo "$cand")"
  [ "$rcand" = "$self" ] && continue
  [ "$(dirname "$rcand")" = "$selfdir" ] && continue
  real="$cand"; break
done < <(type -aP gh 2>/dev/null)
if [ -z "$real" ]; then
  for c in /usr/bin/gh /usr/local/bin/gh; do [ -x "$c" ] && { real="$c"; break; }; done
fi
[ -z "$real" ] && { echo "agent-lab gh-shim: cannot locate the real gh" >&2; exit 127; }

block() { echo "BLOCKED by agent-lab policy: $1 (see AGENTS.md — Autonomy boundary)" >&2; exit 2; }

args=("$@")
n=${#args[@]}
i=0
sub=""
while [ "$i" -lt "$n" ]; do
  case "${args[$i]}" in
    -R | --repo | --hostname) i=$((i + 2)); continue ;;
    --repo=* | --hostname=* | --help | --version) i=$((i + 1)); continue ;;
    -*) i=$((i + 1)); continue ;;
    *) sub="${args[$i]}"; break ;;
  esac
done

case "$sub" in
  auth) block "GitHub authentication access is forbidden" ;;
  pr)
    [ "$i" -eq 0 ] || block "GitHub PR commands must target the current repository directly"
    for a in "${args[@]:$((i + 2))}"; do
      case "$a" in
        -R | -R?* | --repo | --repo=* | --hostname | --hostname=*)
          block "GitHub PR commands must target the current repository directly" ;;
      esac
    done
    case "${args[$((i + 1))]:-}" in
      list | view | status | checks | diff) ;;
      create)
        branch="$(git symbolic-ref --short -q HEAD 2>/dev/null || echo DETACHED)"
        case "$branch" in
          dev | master | main | DETACHED)
            block "PR creation requires a non-protected work branch" ;;
        esac
        base="" head="" j=$((i + 2))
        while [ "$j" -lt "$n" ]; do
          a="${args[$j]}"
          case "$a" in
            --base | -B)
              j=$((j + 1)); base="${args[$j]:-}" ;;
            --base=*) base="${a#*=}" ;;
            --head | -H)
              j=$((j + 1)); head="${args[$j]:-}" ;;
            --head=*) head="${a#*=}" ;;
          esac
          j=$((j + 1))
        done
        [ "$base" = dev ] || block "PR creation requires explicit --base dev"
        [ -z "$head" ] || [ "$head" = "$branch" ] \
          || block "PR head must be the current work branch"
        ;;
      *) block "PR mutation is forbidden; only reads and create --base dev are allowed" ;;
    esac ;;
  run)
    [ "$i" -eq 0 ] || block "GitHub Actions commands must target the current repository directly"
    case "${args[$((i + 1))]:-}" in
      list | view | watch) ;;
      *) block "GitHub Actions access is read-only" ;;
    esac
    for a in "${args[@]:$((i + 2))}"; do
      case "$a" in
        -R | -R?* | --repo | --repo=* | --hostname | --hostname=*)
          block "GitHub Actions commands must target the current repository directly" ;;
      esac
    done
    ;;
  "" | help | version) ;;
  *) block "GitHub access is limited to the scoped PR and read-only Actions workflow" ;;
esac

exec "$real" "$@"
