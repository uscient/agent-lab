#!/usr/bin/env bash
# PATH shim for `gh` — allows repository-scoped PR/Actions reads, GET-only API diagnosis, and the
# branch-derived PR-create route while blocking authentication, integration, and remote writes.
# Verified intermediate integration is available only through scripts/dev/workstream.
set -uo pipefail

real=""
for c in /usr/bin/gh /usr/local/bin/gh; do [ -x "$c" ] && { real="$c"; break; }; done
[ -z "$real" ] && { echo "agent-lab gh-shim: cannot locate the real gh" >&2; exit 127; }
real_git=""
for c in /usr/bin/git /usr/local/bin/git /bin/git; do [ -x "$c" ] && { real_git="$c"; break; }; done
[ -z "$real_git" ] && { echo "agent-lab gh-shim: cannot locate the real git" >&2; exit 127; }

block() { echo "BLOCKED by agent-lab policy: $1 (see AGENTS.md — Autonomy boundary)" >&2; exit 2; }

valid_group() {
  [ "${#1}" -le 48 ] && [[ "$1" =~ ^[gb][0-9]+[a-z]?-[a-z0-9][a-z0-9-]*$ ]]
}

expected_pr_base() {
  local branch="$1" group=""
  case "$branch" in
    flow) printf 'dev\n' ;;
    work/*)
      [[ "$branch" =~ ^work/[a-z0-9][a-z0-9-]{0,47}$ ]] || return 1
      printf 'dev\n'
      ;;
    group/*)
      valid_group "${branch#group/}" || return 1
      printf 'flow\n'
      ;;
    slice/group/*/*)
      [[ "$branch" =~ ^slice/group/([gb][0-9]+[a-z]?-[a-z0-9][a-z0-9-]*)/[a-z0-9][a-z0-9-]{0,47}$ ]] \
        || return 1
      group="${BASH_REMATCH[1]}"
      valid_group "$group" || return 1
      printf 'group/%s\n' "$group"
      ;;
    slice/*/*)
      [[ "$branch" =~ ^slice/([a-z0-9][a-z0-9-]{0,47})/[a-z0-9][a-z0-9-]{0,47}$ ]] \
        || return 1
      printf 'work/%s\n' "${BASH_REMATCH[1]}"
      ;;
    slice/* | dev | master | main | DETACHED) return 1 ;;
    *) printf 'dev\n' ;;
  esac
}

args=("$@")
n=${#args[@]}
i=0
sub=""
readonly_repo="uscient/agent-lab"
while [ "$i" -lt "$n" ]; do
  case "${args[$i]}" in
    -R | --repo)
      [ "${args[$((i + 1))]:-}" = "$readonly_repo" ] \
        || block "GitHub access must remain scoped to $readonly_repo"
      i=$((i + 2)); continue ;;
    -R?*)
      [ "${args[$i]#-R}" = "$readonly_repo" ] \
        || block "GitHub access must remain scoped to $readonly_repo"
      i=$((i + 1)); continue ;;
    --repo=*)
      [ "${args[$i]#*=}" = "$readonly_repo" ] \
        || block "GitHub access must remain scoped to $readonly_repo"
      i=$((i + 1)); continue ;;
    --hostname | --hostname=*) block "alternate GitHub hosts are forbidden" ;;
    --help | --version) i=$((i + 1)); continue ;;
    -*) i=$((i + 1)); continue ;;
    *) sub="${args[$i]}"; break ;;
  esac
done

case "$sub" in
  auth) block "GitHub authentication access is forbidden" ;;
  pr)
    j=$((i + 2))
    while [ "$j" -lt "$n" ]; do
      a="${args[$j]}"
      case "$a" in
        -R | --repo)
          j=$((j + 1)); [ "${args[$j]:-}" = "$readonly_repo" ] \
            || block "GitHub PR commands must remain scoped to $readonly_repo" ;;
        -R?*) [ "${a#-R}" = "$readonly_repo" ] \
          || block "GitHub PR commands must remain scoped to $readonly_repo" ;;
        --repo=*) [ "${a#*=}" = "$readonly_repo" ] \
          || block "GitHub PR commands must remain scoped to $readonly_repo" ;;
        --hostname | --hostname=*) block "alternate GitHub hosts are forbidden" ;;
      esac
      j=$((j + 1))
    done
    case "${args[$((i + 1))]:-}" in
      list | view | status | checks | diff) ;;
      create)
        branch="$("$real_git" symbolic-ref --short -q HEAD 2>/dev/null || echo DETACHED)"
        required_base="$(expected_pr_base "$branch")" \
          || block "PR creation is not authorized from branch $branch"
        base="" head="" j=$((i + 2))
        while [ "$j" -lt "$n" ]; do
          a="${args[$j]}"
          case "$a" in
            --base | -B)
              j=$((j + 1)); base="${args[$j]:-}" ;;
            --base=*) base="${a#*=}" ;;
            --head | -H)
              j=$((j + 1)); head="${args[$j]:-}" ;;
            --head=*) head="${a#*=}" ;;
          esac
          j=$((j + 1))
        done
        [ "$base" = "$required_base" ] \
          || block "PR creation requires explicit --base $required_base from $branch"
        [ -z "$head" ] || [ "$head" = "$branch" ] \
          || block "PR head must be the current work branch"
        ;;
      *) block "PR mutation is forbidden; only reads and the derived create route are allowed" ;;
    esac ;;
  run)
    case "${args[$((i + 1))]:-}" in
      list | view | watch) ;;
      *) block "GitHub Actions access is read-only" ;;
    esac
    j=$((i + 2))
    while [ "$j" -lt "$n" ]; do
      a="${args[$j]}"
      case "$a" in
        -R | --repo)
          j=$((j + 1)); [ "${args[$j]:-}" = "$readonly_repo" ] \
            || block "GitHub Actions commands must remain scoped to $readonly_repo" ;;
        -R?*) [ "${a#-R}" = "$readonly_repo" ] \
          || block "GitHub Actions commands must remain scoped to $readonly_repo" ;;
        --repo=*) [ "${a#*=}" = "$readonly_repo" ] \
          || block "GitHub Actions commands must remain scoped to $readonly_repo" ;;
        --hostname | --hostname=*) block "alternate GitHub hosts are forbidden" ;;
      esac
      j=$((j + 1))
    done
    ;;
  api)
    endpoint="" method="GET" j=$((i + 1))
    while [ "$j" -lt "$n" ]; do
      a="${args[$j]}"
      case "$a" in
        -X | --method) j=$((j + 1)); method="${args[$j]:-}" ;;
        -X?*) method="${a#-X}" ;;
        --method=*) method="${a#*=}" ;;
        -f | -F | --field | --raw-field | --input | -H | --header | --hostname)
          block "GitHub API access is GET-only" ;;
        -f?* | -F?* | --field=* | --raw-field=* | --input=* | -H?* | --header=* | --hostname=*)
          block "GitHub API access is GET-only" ;;
        --paginate | --slurp | --include | --silent) ;;
        --cache | --jq | --template)
          j=$((j + 1)); [ "$j" -lt "$n" ] || block "GitHub API option is missing its value" ;;
        --cache=* | --jq=* | --template=*) ;;
        -*) block "unsupported GitHub API option" ;;
        *) [ -z "$endpoint" ] || block "GitHub API accepts one repository endpoint"
           endpoint="${a#/}" ;;
      esac
      j=$((j + 1))
    done
    [ "${method^^}" = GET ] || block "GitHub API access is GET-only"
    case "$endpoint" in
      repos/uscient/agent-lab | repos/uscient/agent-lab/* | repos/uscient/agent-lab\?*) ;;
      *) block "GitHub API access must remain scoped to $readonly_repo" ;;
    esac
    ;;
  "" | help | version) ;;
  *) block "GitHub access is limited to scoped PR/Actions reads and GET-only repository API reads" ;;
esac

exec "$real" "$@"
