# Strict Docker-free security gate.
# Format:
#   tool  <executable>
#   tool-any <executable-a> <executable-b>
#   suite <stable-id> <repo-relative-script> <required completion marker...>

tool awk
tool bash
tool basename
tool cat
tool chmod
tool cmp
tool cp
tool diff
tool dirname
tool env
tool file
tool find
tool git
tool grep
tool head
tool jq
tool ln
tool mkdir
tool mktemp
tool mv
tool readlink
tool rmdir
tool sed
tool shellcheck
tool sort
tool stat
tool tr
tool wc
tool-any sha256sum shasum

suite lint scripts/dev/lint-scripts PASS lint-scripts
suite gate-contract tests/dev/security-gate-cases.sh SUMMARY failures=0
suite ci-workflow-contract tests/dev/ci-workflow-cases.sh SUMMARY failures=0
suite required-gates-contract tests/dev/required-gates-cases.sh SUMMARY failures=0
suite guard-diff tests/dev/guard-diff-cases.sh SUMMARY failures=0
suite docker-harness-contract tests/dev/docker-harness-cases.sh SUMMARY failures=0
suite guard-command tests/guard/pretooluse-cases.sh SUMMARY failures=0
suite guard-mount tests/guard/cases.sh SUMMARY failures=0
suite config-authority tests/agent/config-guard.sh SUMMARY failures=0
suite config-matrix tests/agent/config-matrix.sh SUMMARY failures=0
suite allowlist-schema tests/agent/allowlist-cases.sh SUMMARY failures=0
suite image-volume-policy tests/agent/image-volume-policy-cases.sh SUMMARY failures=0
suite runtime-inspector tests/agent/runtime-inspector-cases.sh SUMMARY failures=0
suite secret-parser tests/agent/entrypoint-secret-cases.sh SUMMARY failures=0
suite doctor-secret-scan tests/agent/doctor-secret-scan-cases.sh SUMMARY failures=0
suite egress-policy-transition tests/egress/policy-transition-cases.sh SUMMARY failures=0
suite dns-contract-unit tests/egress/dns-contract-cases.sh SUMMARY failures=0
suite wrapper-context tests/wrap-image/context-cases.sh SUMMARY failures=0
suite adapter-idempotence tests/agent/render-adapters-idempotence.sh PASS generated adapters match tracked files and are idempotent
suite serena-config tests/serena/config-cases.sh SUMMARY failures=0
suite policy-probe tests/agent/policy-verify.sh SUMMARY pass=
suite containment-static tools/containment-lint.sh containment-lint: 0 fail, 0 warn
